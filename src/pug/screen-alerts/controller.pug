section.screen-alerts
	h2 Screen Alerts #[a(href="/screen-alerts/component.html" target="_blank") Component]
	.content
		h3 Simulate Alert
		.button-group
			button.tw.alert#tw-follow TW Follow	
			button.tw.alert#tw-sub TW Sub
			button.tw.alert#tw-gift-sub TW Gift Sub
			button.tw.alert#tw-gift-sub-multi TW Gift Sub x5
			button.tw.alert#tw-bits TW Bits x500
			button.yt.alert#yt-sub YT Sub
			button.yt.alert#yt-member YT Member
			button.yt.alert#yt-superchat YT Superchat
			button.yt.alert#yt-donation YT Donation
		h3 Queued Alerts
		ul#alert-queue-list
			li.empty No alerts queued
	link(rel="stylesheet", href="/screen-alerts/controller.css")
	script(src="js/screen-alerts/controller.js") 